{
  "name": "@sypra-ui/ui",
  "version": "0.4.0",
  "description": "Accessible, themeable React UI primitives.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/surya-mp/ui-components.git",
    "directory": "ui"
  },
  "homepage": "https://github.com/surya-mp/ui-components#readme",
  "bugs": "https://github.com/surya-mp/ui-components/issues",
  "keywords": [
    "accessible",
    "components",
    "react",
    "tailwindcss",
    "typescript",
    "ui"
  ],
  "type": "module",
  "sideEffects": [
    "./src/styles.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./primitives": {
      "types": "./dist/primitives/index.d.ts",
      "import": "./dist/primitives/index.js"
    },
    "./widgets": {
      "types": "./dist/widgets/index.d.ts",
      "import": "./dist/widgets/index.js"
    },
    "./styles.css": "./src/styles.css"
  },
  "files": [
    "dist",
    "src/styles.css",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.tsx src/primitives/index.ts src/widgets/index.ts --format esm --dts --sourcemap --external react --external react-dom --clean",
    "prepack": "pnpm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src && prettier --check src"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@testing-library/react": "^16.1.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/user-event": "^14.5.2",
    "@vitest/coverage-v8": "^2.1.8",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "jsdom": "^25.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}

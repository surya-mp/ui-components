{
  "name": "@sypra-ui/pages",
  "version": "0.8.0",
  "description": "Data-and-callback driven React page compositions.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/surya-mp/ui-components.git",
    "directory": "pages"
  },
  "homepage": "https://github.com/surya-mp/ui-components#readme",
  "bugs": "https://github.com/surya-mp/ui-components/issues",
  "keywords": [
    "audit",
    "auth",
    "billing",
    "notifications",
    "pages",
    "payments",
    "react",
    "saas",
    "stripe",
    "tailwindcss",
    "typescript"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./widgets": {
      "types": "./dist/widgets/index.d.ts",
      "import": "./dist/widgets/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.tsx src/widgets/index.ts --format esm --dts --sourcemap --external react --external react-dom --external @sypra-ui/ui --external @stripe/react-stripe-js --external @stripe/stripe-js --clean",
    "prepack": "pnpm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src && prettier --check src"
  },
  "peerDependencies": {
    "@stripe/react-stripe-js": "^6.12.0",
    "@stripe/stripe-js": "^9.17.0",
    "@sypra-ui/ui": "^0.3.0",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@stripe/react-stripe-js": "^6.12.0",
    "@stripe/stripe-js": "^9.17.0",
    "@sypra-ui/ui": "workspace:*",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@vitest/coverage-v8": "^2.1.8",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "jsdom": "^25.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
